# ==============================================================================
# PEK API — CONFIGURATION D'ENVIRONNEMENT DE PRODUCTION (.env)
# ==============================================================================

# --- CONFIGURATION PRINCIPALE DE L'APPLICATION ---
APP_NAME="PEK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pek-backoffice.koriassetmanagement.com
FRONTEND_URL=https://pek.koriassetmanagement.com

# --- JOURNAUX D'ÉVÉNEMENTS (LOGS) ---
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- BASE DE DONNÉES PRODUCTION (MySQL / MariaDB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pek_production_db
DB_USERNAME=pek_db_user
DB_PASSWORD=

# --- GESTION DES SESSIONS, CACHE ET FILES D'ATTENTE ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=pek.koriassetmanagement.com,pek-mobile.koriassetmanagement.com,pek-backoffice.koriassetmanagement.com
SANCTUM_EXPIRATION=1440

# --- MESSAGERIE TRANSACTIONNELLE (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=koriam2023@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@koriassetmanagement.com
MAIL_FROM_NAME="PEK Asset Management"
MAIL_COMPLIANCE_ADDRESS=conformite@koriassetmanagement.com

# --- PASSERELLE DE PAIEMENT STRIPE (CARTE BANCAIRE) ---
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CHECKOUT_TTL_MINUTES=30
STRIPE_CHECKOUT_ALLOWED_HOSTS=checkout.stripe.com

# --- PASSERELLE MAVIANCE / S3P (ORANGE MONEY & MTN MOMO) ---
S3P_ENABLED=true
S3P_BASE_URL=https://s3p.smobilpay.maviance.info
S3P_ALLOWED_HOSTS=s3p.smobilpay.maviance.info
S3P_API_VERSION=3.0.0
# Laisser vide sur Linux / cPanel (utilise le magasin de certificats natif du système)
S3P_CA_BUNDLE=
S3P_PUBLIC_KEY=
S3P_SECRET_KEY=
S3P_WEBHOOK_SECRET=
S3P_ORANGE_SERVICE_ID=
S3P_MTN_SERVICE_ID=
S3P_ORANGE_MERCHANT=
S3P_MTN_MERCHANT=
S3P_ORANGE_WALLET_FORMAT=international
S3P_MTN_WALLET_FORMAT=international
S3P_TIMESTAMP_TIMEZONE=Africa/Douala
S3P_VERIFY_TIMESTAMP_IS_RECEIPT=false
MOBILE_MONEY_SIMULATION=false

# --- VÉRIFICATION D'IDENTITÉ IDENFY (OPTIONNEL) ---
IDENTITY_VERIFICATION_PROVIDER=idenfy
IDENTITY_VERIFICATION_REQUIRED=false
IDENTITY_VERIFICATION_SESSION_LIFETIME=900
IDENTITY_VERIFICATION_SESSION_LENGTH=600
IDENFY_BASE_URL=https://ivs.idenfy.com
IDENFY_API_KEY=
IDENFY_API_SECRET=
IDENFY_WEBHOOK_SIGNING_SECRET=
IDENFY_CALLBACK_URL=https://pek-backoffice.koriassetmanagement.com/api/v1/identity-verification/idenfy/webhook
IDENFY_COUNTRY=CM
IDENFY_DOCUMENTS=PASSPORT,ID_CARD,RESIDENCE_PERMIT
IDENFY_ALLOWED_REDIRECT_HOSTS=ivs.idenfy.com,ui.idenfy.com

# --- SÉCURITÉ ANTIVIRUS DES DOCUMENTS CLIENTS ---
# Chemin absolu de l'exécutable clamscan (ex: /usr/bin/clamscan) si disponible
PAYMENT_PROOF_SCANNER=
