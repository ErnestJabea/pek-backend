APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SANCTUM_EXPIRATION=1440

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_COMPLIANCE_ADDRESS=

MAVIANCE_ENABLED=false
ENKAP_CLIENT_ID=
ENKAP_CLIENT_SECRET=
ENKAP_BASE_URL=https://api.enkap-staging.maviance.info
ENKAP_EVISA_URL=https://api-evisa.enkap-staging.maviance.info
ENKAP_CHECKOUT_TTL_MINUTES=30
ENKAP_CHECKOUT_ALLOWED_HOSTS=payment.enkap.cm,payment.enkap-staging.maviance.info,api-evisa.enkap-staging.maviance.info
MAVIANCE_PUBLIC_KEY=
MAVIANCE_PRIVATE_KEY=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_TTL_MINUTES=30
STRIPE_CHECKOUT_ALLOWED_HOSTS=checkout.stripe.com

IDENTITY_VERIFICATION_PROVIDER=idenfy
IDENTITY_VERIFICATION_REQUIRED=false
IDENTITY_VERIFICATION_SESSION_LIFETIME=900
IDENTITY_VERIFICATION_SESSION_LENGTH=600
IDENFY_BASE_URL=https://ivs.idenfy.com
IDENFY_API_KEY=
IDENFY_API_SECRET=
IDENFY_WEBHOOK_SIGNING_SECRET=
IDENFY_CALLBACK_URL=
IDENFY_COUNTRY=CM
IDENFY_DOCUMENTS=PASSPORT,ID_CARD,RESIDENCE_PERMIT
IDENFY_ALLOWED_REDIRECT_HOSTS=ivs.idenfy.com,ui.idenfy.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

# Dedicated S3P credentials: never reuse e-nkap credentials or exported Postman tokens.
S3P_ENABLED=false
S3P_BASE_URL=https://s3p.smobilpay.staging.maviance.info
S3P_ALLOWED_HOSTS=s3p.smobilpay.staging.maviance.info
S3P_API_VERSION=3.0.0
# Optional trusted CA bundle when PHP has no configured trust store. Never disable verification.
S3P_CA_BUNDLE=
S3P_PUBLIC_KEY=
S3P_SECRET_KEY=
S3P_WEBHOOK_SECRET=
# Collection/cashout service IDs granted to this merchant by Maviance.
S3P_ORANGE_SERVICE_ID=
S3P_MTN_SERVICE_ID=
# Exact merchant codes granted by Maviance; do not infer from phone prefixes.
S3P_ORANGE_MERCHANT=
S3P_MTN_MERCHANT=
# serviceNumber format per operator contract; customerPhonenumber stays international.
S3P_ORANGE_WALLET_FORMAT=international
S3P_MTN_WALLET_FORMAT=international
# Set only after confirmation by Maviance (legacy timestamps carry no timezone).
S3P_TIMESTAMP_TIMEZONE=
S3P_VERIFY_TIMESTAMP_IS_RECEIPT=false
MOBILE_MONEY_SIMULATION=false
# Absolute path to clamscan; absent/unavailable => uploaded files stay quarantined.
PAYMENT_PROOF_SCANNER=
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
